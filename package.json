{
  "name": "mapbox-stylefiles",
  "version": "1.1.0",
  "description": "This repository manages Mapbox Stylefile and Sprite files for the applicaiton.",
  "main": "src/sprite-create.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "sprite": "node src/sprite-create.js",
    "build": "npm run build:unvt && npm run build:building && npm run build:bing-aerial",
    "build:unvt": "charites build charites/style.yml docs/unvt/style.json",
    "build:building": "charites build charites/style-buildings.yml docs/unvt/style-buildings.json",
    "build:mapbox-street": "charites build charites/style-mapbox-street.yml docs/street/style.json",
    "build:mapbox-satellite": "charites build charites/style-mapbox-satellite.yml docs/satellite/style.json",
    "build:mapbox-terrain": "charites build charites/style-mapbox-terrain.yml docs/terrain/style.json",
    "build:bing-aerial": "charites build charites/style-bing-aerial.yml docs/unvt/style-aerial.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasac/mapbox-stylefiles.git"
  },
  "author": "Jin IGARASHI",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/wasac/mapbox-stylefiles/issues"
  },
  "homepage": "https://github.com/wasac/mapbox-stylefiles#readme",
  "dependencies": {
    "@unvt/charites": "^0.1.4",
    "@watergis/sprite-creator": "^0.1.0"
  }
}
